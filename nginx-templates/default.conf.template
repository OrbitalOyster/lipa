server {
  listen ${HTTP_PORT};
  server_tokens off;

  include   mime.types;
  charset        utf-8;
  keepalive_timeout 60;
  gzip on;
  gzip_types  text/plain application/javascript application/x-javascript text/javascript text/css;

  # Cache
  expires 30d;
#  add_header Cache-Control "public, no-transform";

  # Root path
  location / {
      proxy_pass http://${HTTP_HOST}:${HTTP_PORT};
      # proxy_cache off;
      add_header Cache-Control "no-cache";
  }

  # Static files
  location ~ ^/(css/|js/|img/|favicon.ico) {
    root /usr/share/nginx/html;
  }

  # Vendor static files
  location /bootstrap/ {
    alias /usr/share/nginx/html/vendor/bootstrap/dist/;
  }

  location /bootstrap-icons/ {
    alias /usr/share/nginx/html/vendor/bootstrap-icons/font/;
  }

  location /htmx/ {
    alias /usr/share/nginx/html/vendor/htmx/dist/;
  }

  # All errors from proxied API redirect to custom error page
  proxy_intercept_errors on;
  error_page 404 403 /404.html;
  location = /404.html {
      root /usr/share/nginx/html/;
      internal;
  }
}
