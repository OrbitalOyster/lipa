# Where all data
DATA_FOLDER=/var/opt/INSERT_DATA_FOLDER

# Timezone is UTC by default
TZ=Europe/Moscow

# DB
DB_USER=INSERT_DB_USER
DB_PASSWORD=INSERT_DB_PASSWORD
DB_PORT=5432
DB_EXTERNAL_PORT=14001
DB_NAME=INSERT_DB_NAME

# API
GIN_MODE=release
COOKIE_NAME=token
# One hour
COOKIE_LIFETIME=3600
# Three days
COOKIE_LONG_LIFETIME=259200
TOKEN_SECRET=INSERT_LONG_RANDOM_STRING

# NGINX
PORT=80
